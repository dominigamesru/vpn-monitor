# Секреты VPN Monitor — креды целей, только на чтение. Файл лежит в папке установки рядом с exe
# (%LOCALAPPDATA%\DominiVPNMonitor\secrets.env) и никуда не отправляется; в лог значения не пишутся.
# Формат и имена — как в .env репозитория: можно просто скопировать свой .env сюда.
# Переменная окружения с тем же именем главнее файла.

# --- Confluence (светофор) ---
# СЕКРЕТ. Personal Access Token: Confluence → профиль → Personal Access Tokens. Если пусто — вход логином/паролем ниже.
CONFLUENCE_TOKEN=
CONFLUENCE_USER=
# СЕКРЕТ. Пароль AD (нужен, только если нет CONFLUENCE_TOKEN)
CONFLUENCE_PASSWORD=

# --- SVN (VisualSVN) — логин/пароль AD ---
SVN_USER=
# СЕКРЕТ. Пароль AD
SVN_PASSWORD=

# --- GitLab ---
# СЕКРЕТ. Personal Access Token: https://gitlab.dominigames.com/-/user_settings/personal_access_tokens
# права: read_repository (или read_api)
GITLAB_TOKEN=

# --- Необязательно: другие адреса проб вместо адресов из настроек ---
# CONFLUENCE_TEST_PAGE_URL=
# SVN_TEST_FILE_LITE_PATH=
# SVN_TEST_FILE_PATH=
# GITLAB_PROBE_URL=
