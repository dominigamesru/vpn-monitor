# Настройки и секреты. Заполняется скиллом /setup-env: несекретное вписывает агент, секреты (*_TOKEN, *_PASSWORD) —
# только вы сами. Проверка: python scripts/check_env.py
#
# Правила для новых ключей: группа — заголовком «# --- … ---»; над каждым ключом — что это и откуда взять;
# секрет — пометкой «СЕКРЕТ.» и ссылкой, где выпустить (и какие права нужны); значение — заглушка, не настоящее.
# Закомментированный ключ (`# KEY=`) — необязательный.

# --- GitLab ---
# Адрес GitLab офиса
GITLAB_URL=https://gitlab.dominigames.com
# Пробный файл для замера скорости (необязательно; по умолчанию — из настроек приложения)
# GITLAB_PROBE_URL=
# СЕКРЕТ. Personal Access Token: https://gitlab.dominigames.com/-/user_settings/personal_access_tokens
# права: read_repository
GITLAB_TOKEN=paste_token_here

# --- Confluence (светофор) ---
CONFLUENCE_URL=https://confluence.corp.dominigames.com
# Страница, которую качает проба (любая доступная на чтение)
CONFLUENCE_TEST_PAGE_URL=https://confluence.corp.dominigames.com/spaces/IT/pages/37980442
# СЕКРЕТ. Personal Access Token: Confluence → профиль → Personal Access Tokens (права на чтение).
# Если пусто — вход логином и паролем AD ниже.
CONFLUENCE_TOKEN=paste_token_here
CONFLUENCE_USER=your_ad_login
# СЕКРЕТ. Пароль AD (нужен, только если нет CONFLUENCE_TOKEN)
CONFLUENCE_PASSWORD=paste_password_here

# --- Jira (светофор, вход логином AD) ---
JIRA_URL=https://jira.corp.dominigames.com
# Проба: кто вошёл (необязательно; по умолчанию — из настроек приложения)
# JIRA_PROBE_URL=https://jira.corp.dominigames.com/rest/api/2/myself
# СЕКРЕТ. Personal Access Token Jira — необязательно: приложение входит логином и паролем AD
# JIRA_TOKEN=paste_token_here

# --- SVN (VisualSVN) — логин/пароль AD ---
SVN_URL=http://svn.corp.dominigames.com
# Пробные файлы: большой (полная проба) и лёгкий (каждая проверка)
SVN_TEST_FILE_PATH=http://svn.corp.dominigames.com/svn/DC1/DC1_S1/Branches/HUB_FREE/RU/data/movies/se/anim/cmn_map_get.mp4
SVN_TEST_FILE_LITE_PATH=http://svn.corp.dominigames.com/svn/DC1/DC1_S1/Branches/HUB_FREE/RU/data/movies/se/anim/cmn_map_get_alpha.mp4
SVN_USER=your_ad_login
# СЕКРЕТ. Пароль AD
SVN_PASSWORD=paste_password_here

# --- Prometheus: куда слать метрики (Pushgateway) ---
# Адрес Pushgateway, например http://pushgateway.corp.dominigames.com:9091 (пусто — метрики не отправляются)
# PROMETHEUS_PUSHGATEWAY_URL=

# --- Локальные пути ---
# .env другой рабочей копии (worktree без своего .env)
# PROJECT_ENV_FILE=
