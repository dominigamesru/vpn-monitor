# Настройки и секреты. Заполняется скиллом /setup-env: несекретное вписывает агент, секреты (*_TOKEN, *_PASSWORD) —
# только вы сами. Проверка: python scripts/check_env.py
#
# Правила для новых ключей: группа — заголовком «# --- … ---»; над каждым ключом — что это и откуда взять;
# секрет — пометкой «СЕКРЕТ.» и ссылкой, где выпустить (и какие права нужны); значение — заглушка, не настоящее.
# Закомментированный ключ (`# KEY=`) — необязательный.

# --- GitLab ---
# СЕКРЕТ. Personal Access Token: https://gitlab.dominigames.com/-/user_settings/personal_access_tokens
# права: read_repository
GITLAB_TOKEN=paste_token_here

# --- SVN (VisualSVN) — логин/пароль AD ---
SVN_USER=your_ad_login
# СЕКРЕТ. Пароль AD
SVN_PASSWORD=paste_password_here

# --- Prometheus: куда слать метрики (Pushgateway) ---
# Адрес Pushgateway, например http://pushgateway.corp.dominigames.com:9091 (пусто — метрики не отправляются)
# PROMETHEUS_PUSHGATEWAY_URL=

# --- Локальные пути ---
# .env другой рабочей копии (worktree без своего .env)
# PROJECT_ENV_FILE=
